create table if not exists public.bies_briefs (
  id uuid primary key default gen_random_uuid(),
  name text not null,
  email text not null,
  brand text,
  stage text,
  volume text,
  service text,
  message text,
  created_at timestamptz not null default now()
);

alter table public.bies_briefs enable row level security;

create policy "public can submit a brief"
  on public.bies_briefs
  for insert
  to anon, authenticated
  with check (true);
